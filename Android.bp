// MiuiCamera.apk is over GitHub's 100 MB file limit, so it's stored in
// parts and joined at build time.
genrule {
    name: "MiuiCamera_apk",
    srcs: [
        "proprietary/system/priv-app/MiuiCamera/MiuiCamera.apk.part00",
        "proprietary/system/priv-app/MiuiCamera/MiuiCamera.apk.part01",
    ],
    out: ["MiuiCamera.apk"],
    cmd: "cat $(in) > $(out)",
}

android_app_import {
    name: "MiuiCamera",
	overrides: ["Snap", "Camera2", "GCamGOPrebuilt", "Aperture"],
    owner: "xiaomi",
    apk: ":MiuiCamera_apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    required: [
        "MiuiCamera_lib_libsnpe_dsp_domains_v2",
        "MiuiCamera_lib_libsnpe_dsp_skel",
        "MiuiCamera_lib_libsnpe_dsp_v65_domains_v2_skel",
        "MiuiCamera_lib_libsnpe_dsp_v66_domains_v2_skel",
        "MiuiCamera_lib_libSNPE",
        "MiuiCamera_lib_libsymphony-cpu",
        "MiuiCamera_lib_libvideo_extra_interpolator",
        "MiuiCamera_lib_libvideo_extra_color_converter",
        "MiuiCamera_lib_libDocumentProcess",
        "MiuiCamera_lib_libmialgo_saliency_jni",
        "MiuiCamera_lib_libYuvWatermark",
        "MiuiCamera_lib_libmorpho_memory_allocator",
        "MiuiCamera_lib_libmorpho_panorama_compat",
        "MiuiCamera_lib_libmorpho_panorama_gp3",
        "MiuiCamera_lib_libmorpho_sensor_fusion",
        "miuicamera_system_libSNPE",
    ],
}

android_app_import {
    name: "MiuiExtraPhoto",
