            ],
            shared_libs: [
                "libz",
                "libdl",
                "libm",
                "liblog",
                "libEGL",
                "libGLESv3",
                "libc",
            ],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

