cc_prebuilt_library_shared {
    name: "libSNPE_system",
    stem: "libSNPE",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["libSNPE.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
}
